{
  "name": "todo-widget",
  "version": "1.3.1",
  "description": "A desktop widget for Windows with a daily and weekly planner, tasks, a monthly habit tracker, prayer times, a Deen tab, a journal, goals and linked calendars",
  "author": "adipto03",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/adipto03/todo-widget.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adhan": "^4.4.6",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.0"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "koffi@3.3.0": true
  },
  "build": {
    "appId": "com.todo.widget",
    "publish": [
      {
        "provider": "github",
        "owner": "adipto03",
        "repo": "todo-widget"
      }
    ],
    "productName": "A Widget for Life",
    "copyright": "Copyright © 2026 adipto03",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "scripts/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "desktop-pin.js",
      "renderer/**/*",
      "package.json",
      "!node_modules/**/*.{md,map,d.ts,tsbuildinfo}",
      "!node_modules/koffi/{doc,vendor}/**",
      "!node_modules/koffi/src/**/*.{cc,hh,inc,txt,S,asm,def}",
      "!node_modules/@koromix/*/**/*.lib",
      "!node_modules/adhan/lib/{bundles,esm,types}/**",
      "!node_modules/adhan/*.cjs"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "A Widget for Life",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "A-Widget-for-Life-Setup-${version}.exe"
    }
  }
}
